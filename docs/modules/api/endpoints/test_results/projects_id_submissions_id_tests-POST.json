{
    "endpoint": "/projects/:project_id/submissions/:submission_id/tests",
    "method": "POST",
    "attributes" : {
        ":project_id" : {
            "type": "string/integer",
            "required": true,
            "description": "The id or slug of the project of the submission to create the new test for."
        },
        ":submission_id" : {
            "type": "integer",
            "required": true,
            "description": "The id of the submission to create a new test for."
        },
        "name" : {
            "type": "string",
            "required": true,
            "description": "The name of the new test."
        },
        "measurements" : {
            "type": "array",
            "required": false,
            "description": "An array of measurements to create for the new test."
        },
        "status" : {
            "type": "string",
            "required": false,
            "description": "Status of the test. If not set, the status will be computed from the measurements.Allowed values are 'skip', 'successful', 'unstable', 'unknown', 'failed', or 'broken'."
        }
    },
    "examples" : [
        {
            "name" : "empty",
            "arguments" : {
                "project_id" : 1,
                "submission_id": 1
            },
            "data": {
                "name" : "New Empty Test"
            }
        },
        {
            "name" : "nonempty",
            "arguments" : {
                "project_id" : 1,
                "submission_id": 1
            },
            "data": {
                "name" : "New Test",
                "measurements" : [
                    {
                        "name": "runtime",
                        "value": {
                            "data": "PT0.124356S",
                            "type": "duration"
                        },
                        "status": "failed",
                        "reference": null
                    }
                ]
            }
        }
    ]
}
